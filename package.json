{
  "name": "tianyuan-quant-agent-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm.cmd --prefix frontend run dev",
    "dev:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\start-dev.ps1",
    "dev:all:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\start-dev.ps1 -Install",
    "dev:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\stop-dev.ps1",
    "build": "npm.cmd --prefix frontend run build",
    "lint": "npm.cmd --prefix frontend run lint",
    "typecheck": "npm.cmd --prefix frontend run typecheck",
    "preview": "npm.cmd --prefix frontend run preview",
    "audit:baseline": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\audit-development-baseline.ps1",
    "smoke:frontend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-frontend-routes.ps1",
    "smoke:frontend:responsive": "node scripts\\smoke-frontend-responsive.mjs",
    "chaos:isolated": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\chaos-validation.ps1",
    "smoke:db-backup-restore": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\db-backup-restore-drill.ps1",
    "smoke:db-offhost-backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\db-offhost-backup-drill.ps1",
    "smoke:storage-offhost-restore": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\storage-offhost-restore-drill.ps1",
    "smoke:mfe-mae-quant-core": "npm.cmd run test:backend -- backend\\tests\\test_mfe_mae_quant_core_chain.py -q --basetemp=.tmp\\pytest-mfe-mae-quant-core",
    "smoke:signalops-auto-paper-chain": "npm.cmd run test:backend -- backend\\tests\\test_auto_paper_trading.py::test_auto_paper_tick_creates_sim_buy_without_manual_intervention backend\\tests\\test_auto_paper_routes.py::test_auto_paper_tick_route_forced_and_blocked -q --basetemp=.tmp\\pytest-signalops-auto-paper-chain",
    "smoke:analysis-worker": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-analysis-worker.ps1",
    "smoke:closed-loop-participation": "npm.cmd run test:backend -- backend\\tests\\test_closed_loop_sample.py::test_p2_closed_loop_sample_route_materializes_full_chain -q --basetemp=.tmp\\pytest-closed-loop-participation",
    "smoke:research-closure": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-research-closure-live.ps1",
    "smoke:research-closure:browser": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-research-closure-live.ps1 -BrowserSmoke",
    "smoke:strict-auth-browser": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-strict-auth-browser.ps1",
    "smoke:strict-auth-browser:platform": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-strict-auth-browser.ps1 -Scenario platform",
    "smoke:strict-auth-browser:signalops": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-strict-auth-browser.ps1 -Scenario signalops",
    "smoke:strict-auth-browser:research-backtest": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-strict-auth-browser.ps1 -Scenario research-backtest",
    "smoke:strict-auth-browser:portfolio-live-plugin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-strict-auth-browser.ps1 -Scenario portfolio-live-plugin",
    "smoke:strict-auth-browser:matrix": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\smoke-strict-auth-browser-matrix.ps1",
    "validate:module-participation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\module-participation-validation.ps1",
    "validate:phase1-3": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\phase1-3-validation.ps1",
    "validate:premerge": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\pre-merge-validation.ps1",
    "worker:analysis": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\analysis-worker.ps1",
    "test": "npm.cmd run test:backend",
    "test:frontend": "npm.cmd --prefix frontend run typecheck",
    "test:preview-security": "node --test scripts/test-preview-dist.cjs",
    "test:session-persistence": "node --test scripts/test-session-persistence.cjs",
    "test:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-backend.ps1",
    "test:backend:all": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-backend.ps1 -All"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2"
  }
}
